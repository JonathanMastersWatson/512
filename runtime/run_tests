#!/usr/bin/env python3
import json
import sys
from evaluator import evaluate

try:
    with open("tests.json", "r") as f:
        tests = json.load(f)
except Exception:
    print("DENY invalid_tests_file")
    sys.exit(1)

for t in tests:
    try:
        result, _ = evaluate(t["input"])
        outcome = "ALLOW" if result else "DENY"
    except Exception:
        outcome = "DENY"

    if outcome == t.get("expected"):
        print(f"PASS {t.get('name')}")
    else:
        print(f"FAIL {t.get('name')} expected={t.get('expected')} got={outcome}")
