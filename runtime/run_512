#!/usr/bin/env python3
import json
import sys
from evaluator import evaluate

if len(sys.argv) != 2:
    print("DENY invalid_usage")
    sys.exit(1)

try:
    with open(sys.argv[1], "r") as f:
        request = json.load(f)
except Exception:
    print("DENY invalid_request")
    sys.exit(1)

try:
    result, invariant = evaluate(request)
except Exception:
    print("DENY evaluation_error")
    sys.exit(1)

if result:
    print("ALLOW")
else:
    print(f"DENY {invariant}")
