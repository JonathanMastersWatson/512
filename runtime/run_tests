#!/usr/bin/env python3
import json
from evaluator import evaluate

with open("tests.json", "r") as f:
    tests = json.load(f)

for t in tests:
    result, _ = evaluate(t["input"])
    outcome = "ALLOW" if result else "DENY"

    if outcome == t["expected"]:
        print(f"PASS: {t['name']}")
    else:
        print(f"FAIL: {t['name']} (expected {t['expected']}, got {outcome})")
